generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Category {
  id                String              @id @default(cuid())
  name              String
  type              String
  color             String
  icon              String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  incomeEntries     IncomeEntry[]
  budgetAllocations BudgetAllocation[]
  subscriptions     Subscription[]
  recurringBills    RecurringBill[]
  debts             Debt[]
}

model IncomeEntry {
  id         String   @id @default(cuid())
  source     String
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  amount     Int
  month      String
  notes      String?
  createdAt  DateTime @default(now())
}

model BudgetAllocation {
  id               String   @id @default(cuid())
  categoryId       String
  category         Category @relation(fields: [categoryId], references: [id])
  month            String
  allocatedAmount  Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  @@unique([categoryId, month])
}

model Subscription {
  id              String               @id @default(cuid())
  name            String
  amount          Int
  currency        String               @default("IDR")
  billingCycle    String
  nextBillingDate DateTime
  categoryId      String
  category        Category             @relation(fields: [categoryId], references: [id])
  status          String               @default("active")
  notes           String?
  createdAt       DateTime             @default(now())
  payments        SubscriptionPayment[]
}

model SubscriptionPayment {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
  amount         Int
  paidDate       DateTime
  createdAt      DateTime     @default(now())
}

model RecurringBill {
  id          String         @id @default(cuid())
  name        String
  defaultAmount Int
  dueDay      Int
  categoryId  String
  category    Category       @relation(fields: [categoryId], references: [id])
  status      String         @default("active")
  notes       String?
  createdAt   DateTime       @default(now())
  payments    BillPayment[]
}

model BillPayment {
  id        String        @id @default(cuid())
  billId    String
  bill      RecurringBill @relation(fields: [billId], references: [id])
  amount    Int
  month     String
  paidDate  DateTime?
  isPaid    Boolean       @default(false)
  createdAt DateTime      @default(now())
}

model Debt {
  id              String        @id @default(cuid())
  name            String
  creditor        String
  principalAmount Int
  remainingAmount Int
  interestRate    Float
  monthlyPayment  Int
  startDate       DateTime
  categoryId      String
  category        Category      @relation(fields: [categoryId], references: [id])
  status          String        @default("active")
  notes           String?
  createdAt       DateTime      @default(now())
  payments        DebtPayment[]
}

model DebtPayment {
  id          String   @id @default(cuid())
  debtId      String
  debt        Debt     @relation(fields: [debtId], references: [id])
  amount      Int
  paymentDate DateTime
  notes       String?
  createdAt   DateTime @default(now())
}


